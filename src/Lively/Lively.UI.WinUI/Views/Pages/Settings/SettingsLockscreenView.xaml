<Page
    x:Class="Lively.UI.WinUI.Views.Pages.Settings.SettingsLockscreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:customConverters="using:Lively.UI.WinUI.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lively.UI.WinUI.Views.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <customConverters:BooleanToVisibilityConverter x:Key="VisibilityConverter" />
        <customConverters:AudioVolumeGlyphConverter x:Key="AudioVolumeGlyphConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="10,25,10,5" Spacing="{StaticResource SettingGroupControlSpacing}">
                <!-- Appearance and Behaviour -->
                <StackPanel>
                    <TextBlock
                        x:Uid="AppearanceBehaviour"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />

                    <!-- Enable Live Lock Screen -->
                    <controls:SettingsCard x:Uid="LockscreenEnable">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsLockscreenEnabled, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <!-- Auto-lock on idle wait time -->
                    <controls:SettingsCard x:Uid="LockscreenWaitTime">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE916;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{Binding SelectedLockscreenWaitIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="15" />
                            <ComboBoxItem Content="20" />
                            <ComboBoxItem Content="25" />
                            <ComboBoxItem Content="30" />
                            <ComboBoxItem Content="45" />
                            <ComboBoxItem Content="60" />
                            <ComboBoxItem Content="120" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- Show Clock and Date Overlay -->
                    <controls:SettingsCard x:Uid="LockscreenShowClock">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE823;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsShowClock, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <!-- Fade In Transition -->
                    <controls:SettingsCard x:Uid="LockscreenFadeIn">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsFadeIn, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <!-- Sync with Windows Lock Screen Image -->
                    <controls:SettingsCard x:Uid="LockscreenSyncWindowsLockImage">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEB9F;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsSyncWindowsLockImage, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- Audio -->
                <StackPanel>
                    <TextBlock
                        x:Uid="AudioGroup"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />
                    <controls:SettingsCard x:Uid="Audio" HeaderIcon="{Binding Volume, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource AudioVolumeGlyphConverter}}">
                        <Slider
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding Volume, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- System & Preview -->
                <StackPanel>
                    <TextBlock
                        x:Uid="System"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />

                    <!-- Preview Lock Screen -->
                    <controls:SettingsCard
                        x:Uid="LockscreenPreview"
                        Command="{Binding PreviewLockscreenCommand}"
                        IsClickEnabled="True">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE768;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <!-- Open Windows Lock Screen Settings -->
                    <controls:SettingsCard
                        x:Uid="LockscreenWindowsSettings"
                        Command="{Binding OpenWindowsSettingsCommand}"
                        IsClickEnabled="True">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE770;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
